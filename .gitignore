.DS_Store
__pycache__/
*.pyc
node_modules/
# Specimen image outputs are regenerated by render.mjs and published to the
# profile repo; keep only the auditable layout.json / audit.json in git.
profile-art/specimen/out/*.png
profile-art/specimen/out/*.svg
